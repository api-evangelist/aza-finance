{
  "opencollection": "1.0.0",
  "info": {
    "name": "TransferZero Account Debits Senders API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization-Key",
      "value": "{{Authorization-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Senders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Listing senders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-sandbox.transferzero.com/v1/senders",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "The page number to request (defaults to 1)"
              },
              {
                "name": "per",
                "value": "10",
                "type": "query",
                "description": "The number of results to load per page (defaults to 10)"
              },
              {
                "name": "created_at_from",
                "value": "",
                "type": "query",
                "description": "Start date to filter recipients by created_at range\nAllows filtering results by the specified `created_at` timeframe.\n\nExample: `/v1/recipients?created_at_from=2018-06-06&created_at_to=2018-06-08`"
              },
              {
                "name": "created_at_to",
                "value": "",
                "type": "query",
                "description": "End date to filter recipients by created_at range\nAllows filtering results by the specified `created_at` timeframe.\n\nExample: `/v1/recipients?created_at_from=2018-06-06&created_at_to=2018-06-08`"
              },
              {
                "name": "external_id",
                "value": "",
                "type": "query",
                "description": "Allows filtering results by `external_id`.\n\nExample: `/v1/senders?external_id=26ec8517-2f0d-48c0-b74f-0bccb9ab3a87`"
              }
            ]
          },
          "docs": "Get a list of available senders"
        },
        {
          "info": {
            "name": "Creating a sender",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.transferzero.com/v1/senders",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new sender in our system.\n"
        },
        {
          "info": {
            "name": "Fetching a sender",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-sandbox.transferzero.com/v1/senders/:Sender ID",
            "params": [
              {
                "name": "Sender ID",
                "value": "",
                "type": "path",
                "description": "ID of the sender to get.\n\nExample: `/v1/senders/bf9ff782-e182-45ac-abea-5bce83ad6670`"
              }
            ]
          },
          "docs": "Returns a single sender by the Sender ID"
        },
        {
          "info": {
            "name": "Updating a sender",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api-sandbox.transferzero.com/v1/senders/:Sender ID",
            "params": [
              {
                "name": "Sender ID",
                "value": "",
                "type": "path",
                "description": "ID of the sender to get.\n\nExample: `/v1/senders/bf9ff782-e182-45ac-abea-5bce83ad6670`"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates a single sender by the Sender ID"
        },
        {
          "info": {
            "name": "Deleting a sender",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api-sandbox.transferzero.com/v1/senders/:Sender ID",
            "params": [
              {
                "name": "Sender ID",
                "value": "",
                "type": "path",
                "description": "ID of the sender to delete.\n\nExample: `/v1/senders/bf9ff782-e182-45ac-abea-5bce83ad6670`"
              }
            ]
          },
          "docs": "Deletes a single sender by the Sender ID"
        }
      ]
    }
  ],
  "bundled": true
}