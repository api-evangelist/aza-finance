          "name": "Fetch a single mandate",
          "request": {
            "name": "Fetch a single mandate",
            "description": {
              "content": "Finds and returns a Mandate created within the current calendar year,\nwhere the mandate is linked to a Recipient owned by the authenticated\nAPI key.\n\nReturns 404 if the mandate is not owned by the API key or was not\nissued in the current calendar year — mandates are only valid for\nthe year in which they were issued.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "mandates",
                ":Mandate ID"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "Mandate ID",
                  "description": "(Required) ID of the mandate.\n\nExample: `/v1/mandates/bf9ff782-e182-45ac-abea-5bce83ad6670`"
                }
              ]
            },
